	<div class="container">
		<article class="post-type-post" id="post-22094">

			<section class="article-content container">

				<div class="container">

					<header>
						<h1 class="article-h1">Why Calculation Management is Important for Engineers</h1>
												<div class="share" style="visibility:hidden;">
    <button class="share-fb" data-sharer="facebook">
        <svg xmlns="http://www.w3.org/2000/svg" width="32.852" height="32" viewBox="0 0 32.852 32">
